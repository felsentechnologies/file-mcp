<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Shared by the Windows (WPF) and Linux (Avalonia) front ends; platform code is guarded at runtime. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FileMCP.Core</AssemblyName>
    <RootNamespace>FileMCP.Core</RootNamespace>
    <Version>0.4.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FileMCP.Core.Tests" />
  </ItemGroup>
</Project>
